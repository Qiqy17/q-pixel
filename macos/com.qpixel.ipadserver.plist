<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qpixel.ipadserver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__RESOURCES__/run_ipad_server.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__RESOURCES__</string>
  <key>EnvironmentVariables</key>
  <dict><key>QPIXEL_SERVICE</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/tmp/qpixel_ipadserver.log</string>
  <key>StandardErrorPath</key><string>/tmp/qpixel_ipadserver.err.log</string>
</dict>
</plist>
